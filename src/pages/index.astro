---
import BaseLayout from "../layouts/BaseLayout.astro";
const pageTitle = "corii";
const hobbies = [
  "Experiment with computer hardware & software (like this website)",
  "Work on (break) my car",
  "Dabble in a bit of gaming"
];
---

<BaseLayout pageTitle={pageTitle}>
  <h1>{pageTitle}</h1>
  <h2>Whoami</h2>
  <p>
    Greetings gamers I am corii and this is my website 🤯 mostly just using it as practice
  </p>
  <h2>Things I do:</h2>
    <ul>
      {hobbies.map((hobbies) => <li class="hobby">{hobbies}</li>)}
    </ul>
  <h2>Contact me:</h2>
      <ul>
  <li>Discord: 
    <a>cor.ii</a>
  </li>
  <li>GitHub:
    <a href="https://github.com/coriixyz">coriixyz</a>
  </li>
  <li>Twitter: 
    <a href="https://twitter.com/coriixyz">coriixyz</a>
  </li>
  <li>Email: 
    <a href="mailto:mail@corii.me">mail@corii.me</a>
  </li>
</ul>
</BaseLayout>
